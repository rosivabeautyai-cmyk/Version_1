# ROSIVA AI backend — copy to `.env` for local dev (never commit the real .env).
#
# Groq API key — SERVER-SIDE ONLY. Never put this in Flutter, Dart, Android/iOS
# resources, Firebase Remote Config, Firestore, or any client-visible config.
# Get one (no credit card) at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model id. Kept configurable so it can be changed without touching code.
# Inspect current free-tier models at https://console.groq.com/docs/models
# Good default for Arabic + English intent extraction and short chat replies:
GROQ_MODEL=llama-3.3-70b-versatile

# Optional cheaper/faster fallback model used automatically if GROQ_MODEL is
# rate-limited (429). Leave blank to disable fallback.
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# HTTP port the backend listens on.
PORT=8080

# Firebase service account key (the FULL JSON of a service-account key file,
# pasted as a single-line string) with Firestore read access. The Admin SDK
# bypasses Firestore security rules, which is why product reads work server-side.
# Same secret shape as scripts/awin-sync uses.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: comma-separated list of allowed CORS origins. Empty = allow all
# (fine for a mobile app calling the API directly; tighten for web).
ALLOWED_ORIGINS=

# Optional: max Groq call latency before giving up (ms).
GROQ_TIMEOUT_MS=12000
