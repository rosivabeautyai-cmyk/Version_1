rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if the signed-in caller's own users/{uid} doc has
    // role == 'admin'. Used to gate admin-only reads below — this
    // never trusts a client-supplied role, only what's actually
    // stored server-side.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // A user can read their own document; an admin can read any
      // user's document (needed for the Admin Dashboard's user
      // counts/list — verified server-side via isAdmin(), never a
      // client-supplied role claim). Regular users still cannot read
      // each other's documents.
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // A user may create their own document on sign-up, but ONLY
      // with role == "user". This is what stops anyone from signing
      // up and giving themselves the admin role from the client.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'user';

      // A user may update their own document, but the role field can
      // never CHANGE through this rule — so no client can promote or
      // demote an account. The one exception is a doc that has no
      // role field yet at all (e.g. one left incomplete by an old
      // partial write): that can only be backfilled with role ==
      // "user", never "admin". To make someone an admin, edit the
      // `role` field for their document directly in the Firebase
      // console (or from a trusted backend / Cloud Function).
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (
                         ('role' in resource.data)
                           ? request.resource.data.role == resource.data.role
                           : request.resource.data.role == 'user'
                       );

      allow delete: if false;
    }

    // Product catalog, populated only by the Awin sync script running
    // in GitHub Actions (scripts/awin-sync/, using a service-account
    // Admin SDK credential that bypasses these rules entirely — see
    // .github/workflows/awin-sync.yml). Any signed-in app user can
    // read; no client (including admins from within the app) may
    // write.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Sync status / other admin-only operational docs (e.g.
    // admin/awinSyncStatus), written only by the GitHub Actions sync
    // script above. Readable by admins so the Admin Dashboard can
    // show sync state.
    match /admin/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
